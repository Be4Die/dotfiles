#!/usr/bin/env bash
if [ ! -f /etc/gpu-switch-test-mode ]; then
  exit 0
fi

echo "GPU Switch Test Mode is ACTIVE!"
echo "You have 90 seconds to run \"gpu-confirm\" in terminal."
echo "If the screen is black or no confirmation is received, system will auto-revert to AMD."

for i in {90..1}; do
  if [ ! -f /etc/gpu-switch-test-mode ]; then
    echo "Confirmation received. Disarming safety daemon."
    exit 0
  fi
  if [ $((i % 15)) -eq 0 ]; then
    echo "Safety rollback countdown: $i seconds remaining..."
  fi
  sleep 1
done

if [ -f /etc/gpu-switch-test-mode ]; then
  echo "TIMEOUT REACHED without confirmation!"
  /usr/local/bin/gpu-rollback
fi

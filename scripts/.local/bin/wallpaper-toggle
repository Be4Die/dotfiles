#!/usr/bin/env bash
#
# Static Wallpaper Cycler for Hyprland (hyprpaper)
# Usage:
#   wallpaper-toggle        # Cycle to next wallpaper
#   wallpaper-toggle [ID]   # Switch to specific wallpaper ID
#   wallpaper-toggle init   # Initialize wallpaper on startup
#

WALLPAPER_DIR="$HOME/wallpapers"
STATE_FILE="$HOME/.cache/wallpaper_index"
HYPRPAPER_CONF="$HOME/.config/hypr/hyprpaper.conf"

mkdir -p "$HOME/.cache"

# Find total number of wallpapers available
TOTAL_PICS=$(ls -1 "$WALLPAPER_DIR"/h_*.{png,jpg} 2>/dev/null | wc -l)
[ "$TOTAL_PICS" -eq 0 ] && exit 0

CURRENT_INDEX=$(cat "$STATE_FILE" 2>/dev/null || echo 1)

case "$1" in
    init|daemon)
        INDEX="$CURRENT_INDEX"
        ;;
    [0-9]*)
        INDEX="$1"
        ;;
    *)
        # Cycle to next wallpaper
        INDEX=$(( (CURRENT_INDEX % TOTAL_PICS) + 1 ))
        ;;
esac

# Find matching horizontal and vertical image files for INDEX
H_IMG="$WALLPAPER_DIR/h_${INDEX}.png"
[ ! -f "$H_IMG" ] && H_IMG="$WALLPAPER_DIR/h_${INDEX}.jpg"
[ ! -f "$H_IMG" ] && H_IMG=$(ls "$WALLPAPER_DIR"/h_*.{png,jpg} 2>/dev/null | head -n 1)

V_IMG="$WALLPAPER_DIR/v_${INDEX}.png"
[ ! -f "$V_IMG" ] && V_IMG="$WALLPAPER_DIR/v_${INDEX}.jpg"
[ ! -f "$V_IMG" ] && V_IMG="$H_IMG"

# Auto-detect connected monitors and their orientation
get_monitors() {
    hyprctl monitors -j 2>/dev/null | python3 -c "
import json, sys
try:
    monitors = json.load(sys.stdin)
    for m in monitors:
        is_vert = '1' if m.get('transform', 0) in (1, 3) or m.get('height', 0) > m.get('width', 0) else '0'
        print(f\"{m['name']}:{is_vert}\")
except:
    print('HDMI-A-1:0')
" 2>/dev/null || echo "HDMI-A-1:0"
}

# Build hyprpaper.conf dynamically
{
    echo "splash = false"
    echo ""
    while IFS=':' read -r monitor is_vert; do
        SELECTED_IMG="$H_IMG"
        if [ "$is_vert" = "1" ] && [ -n "$V_IMG" ] && [ -f "$V_IMG" ]; then
            SELECTED_IMG="$V_IMG"
        fi
        
        echo "wallpaper {"
        echo "    monitor = $monitor"
        echo "    path = $SELECTED_IMG"
        echo "    fit_mode = cover"
        echo "}"
        echo ""
    done < <(get_monitors)

    # Fallback catch-all monitor entry
    echo "wallpaper {"
    echo "    monitor ="
    echo "    path = $H_IMG"
    echo "    fit_mode = cover"
    echo "}"
} > "$HYPRPAPER_CONF"

# Restart hyprpaper cleanly
killall -9 hyprpaper mpvpaper 2>/dev/null || true
sleep 0.1
nohup hyprpaper >/dev/null 2>&1 &

echo "$INDEX" > "$STATE_FILE"

if [ "$1" != "init" ] && [ "$1" != "daemon" ]; then
    notify-send -a "Обои" -i preferences-desktop-wallpaper "Смена обоев" "Установлена тема #$INDEX" 2>/dev/null || true
fi

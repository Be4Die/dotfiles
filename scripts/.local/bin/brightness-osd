#!/usr/bin/env bash
DIR="$1"
STEP="${2:-5%}"

# 1. Hardware change with GMUX unlock
/usr/local/bin/change-brightness "$DIR" "$STEP"

# 2. Visual OSD in Catppuccin Frappe style
PCT=$(brightnessctl -d gmux_backlight -m 2>/dev/null | awk -F, '{print $4}' | tr -d '%')
if [ -n "$PCT" ]; then
    PROG=$(awk -v p="$PCT" 'BEGIN { printf "%.2f", p / 100 }')
    swayosd-client --custom-icon display-brightness-symbolic --custom-progress "$PROG" --custom-progress-text "${PCT}%" 2>/dev/null &
fi

#!/usr/bin/env bash
# CPU Profile Menu for MacBook Pro (Fuzzel / Hyprland / Waybar)

CURRENT_CONF=$(cat /etc/cpu-limit.conf 2>/dev/null || echo "balance")

case "$CURRENT_CONF" in
    quiet)   CURRENT_TAG="🔇 Тихий 1.2G" ;;
    eco)     CURRENT_TAG="🍃 Эко 1.6G" ;;
    balance) CURRENT_TAG="⚡ Баланс 2.5G" ;;
    turbo)   CURRENT_TAG="🚀 Турбо 3.7G" ;;
    *)       CURRENT_TAG="1.2G" ;;
esac

OPTIONS=(
    "󰌪  Тихий режим (1.2 GHz)     [Для пар: 0 шума, кулеры спят]"
    "󰾆  Энергосбережение (1.6 GHz) [Холодный и плавный]"
    "󰓅  Баланс (2.5 GHz)          [Стандартный режим без Турбо]"
    "🚀 Максимум (3.7 GHz Turbo)   [Пиковая мощность]"
)

PROMPT="󰓅 CPU ($CURRENT_TAG): "

MENU_TEXT=$(printf "%s\n" "${OPTIONS[@]}")
CHOICE=$(echo "$MENU_TEXT" | fuzzel --dmenu --prompt "$PROMPT" --placeholder "Выберите профиль процессора..." --lines 4 --width 54)

case "$CHOICE" in
    *1.2*)
        sudo -n /usr/local/bin/set-cpu-limit quiet
        notify-send -a "CPU" -i "cpu" "Режим процессора: Тихий" "Частота ограничена 1.2 GHz.\nВентиляторы не включатся."
        ;;
    *1.6*)
        sudo -n /usr/local/bin/set-cpu-limit eco
        notify-send -a "CPU" -i "cpu" "Режим процессора: Эко" "Частота ограничена 1.6 GHz.\nХолодный режим для батареи."
        ;;
    *2.5*)
        sudo -n /usr/local/bin/set-cpu-limit balance
        notify-send -a "CPU" -i "cpu" "Режим процессора: Баланс" "Динамический разгон до 2.5 GHz.\nТурбобуст выключен."
        ;;
    *3.7*|*Максимум*)
        sudo -n /usr/local/bin/set-cpu-limit turbo
        notify-send -a "CPU" -i "cpu" "Режим процессора: Максимум" "Включен Turbo Boost до 3.7 GHz.\nМаксимальная производительность."
        ;;
esac

#!/usr/bin/env bash
# Screenshot with Satty annotation editor (Lightshot alternative)

MODE="${1:-region}"

mkdir -p "$HOME/Pictures/Screenshots"

case "$MODE" in
    region|output)
        # Fullscreen freeze with crop tool (exact GitHub demo behavior, no separate window)
        grim -l 0 - | satty --filename - --fullscreen --initial-tool crop
        ;;
    window)
        hyprshot -m window --raw | satty --filename -
        ;;
    quick)
        # Direct region screenshot to clipboard (no annotation editor)
        geom=$(slurp -d -b "#00000066" -c "#ca9ee6" -w 2) || exit 0
        grim -g "$geom" - | wl-copy --type image/png
        notify-send -a "Скриншот" -i "camera-photo" "Снимок скопирован в буфер"
        ;;
    flameshot)
        flameshot gui
        ;;
    *)
        grim -l 0 - | satty --filename - --fullscreen --initial-tool crop
        ;;
esac

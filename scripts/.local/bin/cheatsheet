#!/usr/bin/env python3
import subprocess
import os
import sys

# Shortcut definitions: (Key with Icon, Description, Category, Command_to_run_or_None)
SHORTCUTS = [
    # Приложения
    ("  Super + Q", "Терминал (Alacritty)", "Приложения", "alacritty"),
    ("  Super + E", "Файловый менеджер (Thunar)", "Приложения", "thunar"),
    ("󰍉  Super + R", "Меню приложений (Fuzzel)", "Приложения", "fuzzel"),
    ("󰤨  Super + W", "Меню сетей Wi-Fi", "Приложения", "wifi-menu"),
    ("󰂯  Super + B", "Диспетчер Bluetooth", "Приложения", "blueman-manager"),
    ("󰸗  Super + D", "Календарь и часы", "Приложения", "gsimplecal"),
    ("  Super + Shift + T", "Telegram Desktop", "Приложения", "Telegram"),
    ("󰈹  Super + Shift + F", "Браузер Firefox", "Приложения", "firefox"),
    ("󰨞  Super + Shift + Z", "Редактор кода Zed", "Приложения", "zed"),
    ("󰆍  Super + Shift + H", "Мультиплексор Herder", "Приложения", "alacritty -e herdr"),
    ("󰸉  Super + Shift + W", "Смена темы обоев", "Приложения", "wallpaper-toggle"),
    ("󰐥  Super + Escape", "Меню питания системы", "Приложения", "~/.config/hypr/powermenu.sh"),

    # Окна и воркспейсы
    ("󰅖  Super + C", "Закрыть активное окно", "Окна", None),
    ("󰉈  Super + V", "Плавающий режим (Float)", "Окна", None),
    ("󰘸  F3 (Mission Control)", "Цикл: Тайлинг -> Макс -> Флоат", "Окна", "~/dotfiles/scripts/window-cycle.sh"),
    ("󰁔  Super + Стрелки", "Перемещение фокуса окон", "Окна", None),
    ("󰎤  Super + 1 .. 9, 0", "Перейти на воркспейс 1 .. 10", "Окна", None),
    ("󰑢  Super + Shift + 1..9, 0", "Перенести окно на воркспейс 1 .. 10", "Окна", None),
    ("󰍽  Super + Колесо мыши", "Быстрое переключение воркспейсов", "Окна", None),
    ("󰍽  Super + ЛКМ (Drag)", "Перемещение окна мышью", "Окна", None),
    ("󰍽  Super + ПКМ (Drag)", "Изменение размера окна мышью", "Окна", None),
    ("󰟸  Свайп 3 пальцами", "Смена воркспейсов (Тачпад)", "Окна", None),

    # Скриншоты
    ("  Print / Ctrl + Print", "Снимок области в буфер обмена", "Снимки", "hyprshot -m region --clipboard-only"),
    ("  Super + Print", "Снимок активного окна в файл", "Снимки", "hyprshot -m window"),
    ("  Super + Shift + Print", "Снимок всего экрана в файл", "Снимки", "hyprshot -m output"),
    ("  Alt + Shift + 3", "Весь экран (в стиле macOS)", "Снимки", "hyprshot -m output"),
    ("  Alt + Shift + 4", "Область в буфер (в стиле macOS)", "Снимки", "hyprshot -m region --clipboard-only"),
    ("  Alt + Shift + 5", "Активное окно (в стиле macOS)", "Снимки", "hyprshot -m window"),

    # Железо и мультимедиа
    ("󰃞  F1 / F2", "Яркость экрана меньше / больше", "Железо", "brightness-osd + 5%"),
    ("󰌌  F5 / F6", "Подсветка клавиатуры меньше / больше", "Железо", "kbd-brightness-osd + 5%"),
    ("󰖁  F10 (Mute)", "Включить / выключить звук", "Железо", "swayosd-client --output-volume mute-toggle"),
    ("󰕾  F11 / F12", "Громкость тише / громче", "Железо", "swayosd-client --output-volume raise"),
    ("󰐊  F7 / F8 / F9", "Медиа: Назад / Пауза / Вперед", "Железо", "playerctl play-pause"),
    ("󰌌  Super + Пробел", "Смена раскладки (US / RU)", "Железо", None),
    ("󰍹  Super + P", "Дублирование / внешний монитор", "Железо", "~/dotfiles/scripts/toggle-mirror.sh"),
    ("󰋖  Super + /", "Подсказка по всем шорткатам", "Система", None),
]

import socket

is_laptop = (socket.gethostname() != "cachyos-pc")

LAPTOP_ONLY_KEYS = {
    "󰤨  Super + W",
    "󰘸  F3 (Mission Control)",
    "󰟸  Свайп 3 пальцами",
    "󰃞  F1 / F2",
    "󰌌  F5 / F6",
    "󰍹  Super + P",
}

entries = []
command_map = {}

for key, desc, cat, cmd in SHORTCUTS:
    if not is_laptop and key in LAPTOP_ONLY_KEYS:
        continue
    key_padded = f"{key:<30}"
    desc_padded = f"{desc:<36}"
    cat_badge = f"[{cat}]"
    line = f"{key_padded} │ {desc_padded} │ {cat_badge}"
    entries.append(line)
    if cmd:
        command_map[line] = cmd

menu_input = "\n".join(entries)

cmd = [
    "fuzzel",
    "--dmenu",
    "--prompt", "󰌌  Поиск: ",
    "--placeholder", "Начните вводить для фильтрации комбинаций...",
    "--lines", "18",
    "--width", "86",
]

try:
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    stdout, _ = proc.communicate(input=menu_input)
    selected = stdout.strip() if stdout else None
except Exception:
    sys.exit(0)

if selected and selected in command_map:
    run_target = command_map[selected]
    os.system(f"{run_target} &")
